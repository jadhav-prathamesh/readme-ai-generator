# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Custom API base URL (e.g. for proxies like Omniroute)
# ANTHROPIC_BASE_URL=http://localhost:20128

# Optional: Auth token for proxy authentication
# ANTHROPIC_AUTH_TOKEN=sk-...

# Optional: Claude model override (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

